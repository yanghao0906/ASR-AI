<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.asr.poc</groupId>
  <artifactId>asr-embed-poc</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <djl.version>0.38.0</djl.version>
    <exec.main.class>poc.PocMain</exec.main.class>
  </properties>

  <dependencies>
    <!-- sherpa-onnx Java API：官方未发布 Maven Central，需先 install:install-file 到本地仓库
         （见 poc/README.md），正式工程应改用内部 Nexus/私服托管 -->
    <dependency>
      <groupId>com.k2fsa.sherpa.onnx</groupId>
      <artifactId>sherpa-onnx-jvm</artifactId>
      <version>1.13.8</version>
    </dependency>
    <dependency>
      <groupId>com.k2fsa.sherpa.onnx</groupId>
      <artifactId>sherpa-onnx-native-lib-win-x64</artifactId>
      <version>1.13.8</version>
    </dependency>

    <!-- Vosk：Maven Central 直接可用（Java API 为 JNA 绑定，跨平台同一 jar） -->
    <dependency>
      <groupId>com.alphacephei</groupId>
      <artifactId>vosk</artifactId>
      <version>0.3.45</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.13.0</version>
    </dependency>

    <!-- 句向量：DJL + ONNX Runtime + bge-small-zh-v1.5（与需求文档第 8 节选型一致） -->
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
      <version>${djl.version}</version>
    </dependency>
    <!-- 关键集成点：sherpa-onnx 的 native 包自带 onnxruntime.dll(1.28.2) 并随 JNI 一起加载进进程，
         Windows 按模块名去重会导致 DJL ort-engine 默认的 ORT(1.21.1) 初始化失败；
         故将 ORT Java 绑定钉到同 API 版本(28)的 1.28.0，与 sherpa 的 DLL 共存兼容 -->
    <dependency>
      <groupId>ai.djl.onnxruntime</groupId>
      <artifactId>onnxruntime-engine</artifactId>
      <version>${djl.version}</version>
      <exclusions>
        <exclusion>
          <groupId>com.microsoft.onnxruntime</groupId>
          <artifactId>onnxruntime</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>1.28.0</version>
    </dependency>
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
      <version>${djl.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>${exec.main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
